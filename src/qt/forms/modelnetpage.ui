   <item>
    <widget class="QLabel" name="doctorStatusLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="textInteractionFlags">
      <set>Qt::TextSelectableByMouse</set>
     </property>
     <property name="toolTip">
      <string>First-run doctor from getsetupstatus (fallback checkmodelsetup / getmodelnetworkinfo). showmodel (share + local + aliases) and unhostmodel (unpin+unseed) are RPC analogs of ollama show/rm; this page does not call them or getmodel automatically. Never spends. automatic_spend_atoms stays 0.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="dev348ProfileCloudLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="textInteractionFlags">
      <set>Qt::TextSelectableByMouse</set>
     </property>
     <property name="text">
      <string>0.34.8-dev (not a shipping tag). Operator profile and optional cloud backing. Secrets are never shown. automatic_spend_atoms stays 0.</string>
     </property>
     <property name="toolTip">
      <string>0.34.8-dev panel: getmodelprofile + getcloudstorageinfo when present. Missing RPCs fail closed. Never displays secrets. Does not call FormatResourceGovernorStatus. Cloud backing is optional. Filesystem watch folder is not a publisher watch.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="dev348WatchesLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="textInteractionFlags">
      <set>Qt::TextSelectableByMouse</set>
     </property>
     <property name="text">
      <string>0.34.8-dev (not a shipping tag). Network watches from listmodelwatches. Filesystem -modelwatch / getmodelwatchstatus is not listmodelwatches. Filesystem drop folder is not a publisher watch. PREPARE_FUNDING is unsigned. automatic_spend_atoms stays 0.</string>
     </property>
     <property name="toolTip">
      <string>0.34.8-dev (not a shipping tag). listmodelwatches publisher/collection/query/model watches (watch_id, kind/target, action). Not getmodelwatchstatus / -modelwatch / scanmodelwatch. Missing RPC fails closed. Never displays secrets, credential_ref values, query strings, or presigned URLs. PREPARE_FUNDING is unsigned. automatic_spend_atoms stays 0. This page does not auto-getmodel, spend, or call wallet RPCs.</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="dev348ActivityLabel">
     <property name="wordWrap">
      <bool>true</bool>
     </property>
     <property name="textInteractionFlags">
      <set>Qt::TextSelectableByMouse</set>
     </property>
     <property name="text">
      <string>0.34.8-dev (not a shipping tag). Activity snippet from getmodeleventsequence + last page of getmodelevents. Untrusted event text is not a command, path, RPC, or mandate. automatic_spend_atoms stays 0.</string>
     </property>
     <property name="toolTip">
      <string>0.34.8-dev (not a shipping tag). getmodeleventsequence plus last page of getmodelevents (object_id, event_type only). Missing RPC fails closed; never waitformodelevent. Untrusted event text is not a command, path, RPC, or mandate. Never displays secrets, credential_ref values, query strings, or presigned URLs. automatic_spend_atoms stays 0. This page does not auto-getmodel, spend, or call wallet RPCs.</string>
     </property>
    </widget>
   </item>
