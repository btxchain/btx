       <item>
        <widget class="QLabel" name="capabilityStatusLabel">
         <property name="wordWrap">
          <bool>true</bool>
         </property>
         <property name="text">
          <string>Local capability plane. Prepare/Use, Prefetch, Sleep, Release, Wake, Update, Switch, Events, TTC, and Runtime caps are owner-local. Never spends. automatic_spend_atoms stays 0. Public HTTP is 405. CUDA/ROCm/Metal/NIXL/CXL absence is NOT_RUN, not a stub PASS. remap_only is not Wake success. Smoke blocked is not 100% ready.</string>
         </property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="capabilityButtonRow">
         <item>
          <widget class="QPushButton" name="capabilityEnsureButton">
           <property name="text">
            <string>Prepare / Use</string>
           </property>
           <property name="toolTip">
