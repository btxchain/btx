{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "asset": {
      "pattern": "^(btx|btc|evm):[0-9a-f]{64}:(0|[1-9][0-9]*):(native|0x[0-9a-f]{40})$",
      "type": "string"
    },
    "expires_at": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    },
    "max_fee_atoms": {
      "description": "Atomic units; runtime additionally enforces <= 2^256-1.",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "type": "string"
    },
    "max_total_atoms": {
      "description": "Atomic units; runtime additionally enforces <= 2^256-1.",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "type": "string"
    },
    "max_trade_atoms": {
      "description": "Atomic units; runtime additionally enforces <= 2^256-1.",
      "pattern": "^(0|[1-9][0-9]{0,77})$",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "principal": {
      "maxLength": 16384,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "principal",
    "asset",
    "max_total_atoms",
    "max_trade_atoms",
    "max_fee_atoms",
    "expires_at",
    "nonce"
  ],
  "title": "SwapNet mandate",
  "type": "object"
}
