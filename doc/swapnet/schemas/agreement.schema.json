          "minLength": 1,
          "type": "string"
        },
        "refund_key": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        "refund_payout": {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "asset",
        "amount_atoms",
        "hashlock",
        "claim_key",
        "refund_key",
        "payout",
        "refund_payout",
        "lock_domain",
        "lock_value",
        "lock_commitment",
        "max_claim_fee_atoms",
        "max_refund_fee_atoms"
      ],
      "type": "object"
    },
