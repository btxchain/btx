{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "packet": {
      "type": "object",
      "properties": {
        "body": {
          "type": "object",
          "properties": {
            "version": {
              "const": 2
            },
            "network": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sender": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "recipient": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "kind": {
              "enum": [
                "rfq",
                "quote",
                "proposal",
                "agreement",
                "commit",
                "funded",
                "cancel",
                "ack"
              ]
            },
            "swap_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "issued_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "expires_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "payload": {
              "type": "object"
            }
          },
          "required": [
            "version",
            "network",
            "sender",
            "recipient",
            "kind",
            "swap_id",
            "sequence",
            "issued_at",
            "expires_at",
            "payload"
          ],
          "additionalProperties": false
        },
        "signature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      },
      "required": [
        "body",
        "signature"
      ],
      "additionalProperties": false
    },
    "hops": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    }
  },
  "required": [
    "packet",
    "hops"
  ],
  "additionalProperties": false
}
