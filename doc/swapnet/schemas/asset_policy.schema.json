{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "asset": {
      "type": "string",
      "pattern": "^(btx|btc|evm):[0-9a-f]{64}:(0|[1-9][0-9]*):(native|0x[0-9a-f]{40})$"
    },
    "rpc_url": {
      "type": "string",
      "maxLength": 2048
    },
    "cookie_path": {
      "type": "string",
      "maxLength": 4096
    },
    "wallet": {
      "type": "string",
      "maxLength": 256
    },
    "fee_rate": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "confirmations": {
      "type": "integer",
      "minimum": 1
    },
    "contract": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "runtime_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "asset",
    "rpc_url"
  ],
  "additionalProperties": false
}
