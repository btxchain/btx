  "properties": {
    "schema": {
      "const": "BTX/SecurityEnvelope/v1"
    },
    "kind": {
      "enum": [
        "policy",
        "composition",
        "capsule",
        "challenge",
        "evaluation",
        "receipt",
        "channel",
        "mandate",
        "grant",
        "revocation",
        "control",
        "lease",
        "anchor",
        "peer"
      ]
    },
    "body": {
      "type": "object"
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "public_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{2624}$"
          },
          "signature": {
            "type": "string",
            "pattern": "^[0-9a-f]{4840}$"
          }
        },
        "required": [
          "public_key",
          "signature"
        ],
        "additionalProperties": false
      },
      "maxItems": 16,
      "uniqueItems": true
    }
  },
