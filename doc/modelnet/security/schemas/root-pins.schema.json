{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "BTX/SecurityRootPins/v1"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{96}$"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    }
  },
  "required": [
    "schema",
    "keys",
    "threshold"
  ],
  "additionalProperties": false
}
