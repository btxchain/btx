      "description": "Canonical encoder also enforces the UTF-8 BYTE cap and rejects NUL."
    },
    "active": {
      "type": "boolean"
    },
    "target_kind": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "target_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "previous_record_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTX Model Network v1.1 AliasRecord body"
