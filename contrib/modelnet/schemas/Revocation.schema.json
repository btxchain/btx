{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ext_version",
    "network",
    "signer_role",
    "signer_id",
    "sequence",
    "issued_at",
    "expires_at",
    "target_kind",
    "target_id",
    "reason_code"
  ],
  "properties": {
    "ext_version": {
      "const": 257
    },
    "network": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signer_role": {
      "const": 1
    },
    "signer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "target_kind": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "target_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "reason_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTX Model Network v1.1 Revocation body"
}
