{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ext_version",
    "network",
    "signer_role",
    "signer_id",
    "sequence",
    "issued_at",
    "expires_at",
    "title",
    "description",
    "collection_id",
    "target_observed_groups",
    "suggested_storage_bytes",
    "suggested_lease_seconds"
  ],
  "properties": {
    "ext_version": {
      "const": 257
    },
    "network": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signer_role": {
      "const": 1
    },
    "signer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "title": {
      "type": "string",
      "maxLength": 96,
      "description": "Canonical encoder also enforces the UTF-8 BYTE cap and rejects NUL."
    },
    "description": {
      "type": "string",
      "maxLength": 1024,
      "description": "Canonical encoder also enforces the UTF-8 BYTE cap and rejects NUL."
    },
    "collection_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "target_observed_groups": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "suggested_storage_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "suggested_lease_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BTX Model Network v1.1 PreservationCircle body"
}
