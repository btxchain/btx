        if patch_src.startswith("@"):
            patch = _read_draft_terms(patch_src[1:], where)
        else:
            loaded = _loads_maybe(args[2])
            if not isinstance(loaded, dict):
                _die("bounty-draft --update needs a JSON object", 2)
            patch = loaded
        _refuse_spend_options(patch, where)
        result = rpc(sock, "updatebountydraft", [args[1], patch])
        if not JSON_MODE and not _next_actions(result, "updatebountydraft"):
            print(f"next: {DRAFT_NEXT_HINT}", file=sys.stderr)
        _print(result, "updatebountydraft")
        return
    if args[0] == "--delete":
        if len(args) != 2:
            _die("bounty-draft --delete requires a draft id", 2)
        result = rpc(sock, "deletebountydraft", [args[1]])
        _print(result, "deletebountydraft")
        return
    if args[0] == "--validate":
        if len(args) != 2:
            _die("bounty-draft --validate requires a draft id, @FILE, or JSON object", 2)
        src = args[1]
        terms: dict[str, Any]
        extra: dict[str, Any] = {}
        if src.startswith("@"):
            terms = _read_draft_terms(src[1:], where)
        elif len(src) == 32 and all(c in "0123456789abcdefABCDEF" for c in src):
            draft = rpc(sock, "getbountydraft", [src])
            if not isinstance(draft, dict) or not isinstance(draft.get("terms"), dict):
                _die("bounty-draft --validate: getbountydraft returned no terms")
            terms = draft["terms"]
            extra["draft_id"] = src
            if isinstance(draft.get("copy_text"), str):
                extra["copy_text"] = draft["copy_text"]
        else:
            loaded = _loads_maybe(src)
            if not isinstance(loaded, dict):
                _die("bounty-draft --validate needs a draft id, @FILE, or JSON object", 2)
            terms = loaded
        _refuse_spend_options(terms, where)
        result = rpc(sock, "validatebountyterms", [terms])
        if isinstance(result, dict):
            result.update({k: v for k, v in extra.items() if k not in result})
        if not JSON_MODE and not _next_actions(result, "validatebountyterms"):
            print(f"next: {DRAFT_NEXT_HINT}", file=sys.stderr)
        _print(result, "validatebountyterms")
        return
    if args[0] in ("--file", "-f"):
        if len(args) != 2:
            _die("bounty-draft --file requires exactly one JSON path", 2)
        args = [args[1]]
    if args[0].startswith("@"):
        if len(args) != 1:
            _die("bounty-draft @FILE takes no extra arguments; put every field in the file", 2)
        terms = _read_draft_terms(args[0][1:], where)
    else:
        loaded = _loads_maybe(args[0])
        if isinstance(loaded, dict):
            terms = loaded
        else:
            terms = {"title": str(loaded)}
            if len(args) > 1:
                more = _loads_maybe(args[1])
                if isinstance(more, dict):
                    terms.update(more)
    _refuse_spend_options(terms, where)
    # Title-only incomplete drafts stay unpublished. Do not invent a council.
    result = rpc(sock, "createbountydraft", [terms])
    if isinstance(result, dict) and result.get("published") is True:
        _die("createbountydraft published a draft; incomplete drafts must stay local")
    if not JSON_MODE and not _next_actions(result, "createbountydraft"):
        print(f"next: {DRAFT_NEXT_HINT}", file=sys.stderr)
    _print(result, "createbountydraft")


