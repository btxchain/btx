def _print(result: Any, where: str = "") -> None:
    json.dump(result, sys.stdout, indent=2, ensure_ascii=False, sort_keys=False)
    sys.stdout.write("\n")
    if JSON_MODE:
        return
    if isinstance(result, dict):
        one = result.get("one_liner")
        if isinstance(one, str) and one.strip():
            print(one, file=sys.stderr)
        ct = result.get("copy_text")
        if isinstance(ct, str) and ct.strip():
            print(f"copy_text: {ct}", file=sys.stderr)
    for action in _next_actions(result, where or "result"):
        print(f"next: {action}", file=sys.stderr)


