def _composed_show(sock: str, ref: str) -> dict[str, Any]:
    """ollama-show shape from read-only verbs an older helper already has."""
    resolved = _resolve_user(sock, ref)
    if resolved["how"] == "unresolved":
        _die(
            f"show {ref!r}: no local alias, model name, id, or btx:// URI; "
            "run 'btx-model ls' or 'btx-model search TEXT' first"
        )
    share = rpc(sock, "getmodelsharecard", [_target(resolved)])
    share_obj = share.get("share") if isinstance(share.get("share"), dict) else {}
    rows = _local_rows(sock)
    row = _row_for(resolved, rows)
    mid = str((row or {}).get("model_id") or resolved.get("model_id") or "")
    cards = [c for c in _search_cards(sock) if str(c.get("model_id") or "") == mid]
    card = cards[0] if cards else {}
    job: dict[str, Any] = {}
    for candidate in _live_jobs(sock):
        if mid and str(candidate.get("model_id") or "") == mid:
            job = candidate
            break
    uri = str(share_obj.get("uri") or resolved.get("uri") or (row or {}).get("uri") or _target(resolved))
    local = bool(row) or bool(share.get("local"))
    actions = [f"getmodel {uri} FREE_ONLY"]
    if local:
        actions += [f"link {ref}", f"unhost {ref}", "getmodeltransfers"]
    else:
        actions += ["hostmodel <path>  # keep a local copy before serving"]
    return {
        "schema_version": 2,
        "name": str(card.get("name") or (row or {}).get("label") or ""),
        "aliases": _aliases_for(sock, resolved, row),
        "model_id": mid or str(card.get("model_id") or ""),
        "uri": uri,
        "local": local,
        "bytes": _first_int((row or {}).get("bytes"), card.get("size_bytes"), share_obj.get("size_bytes")),
        "state": (row or {}).get("state"),
        "share": share_obj,
        "transfer": (
            {
                "job_id": job.get("job_id"),
                "status": job.get("status"),
                "bytes_committed": _as_int(job.get("bytes_committed")),
                "bytes_per_sec": _as_int(job.get("bytes_per_sec")),
            }
            if job
            else None
        ),
        "signed_metadata": share.get("signed_metadata"),
        "resolved_by": resolved["how"],
        "next_actions": actions,
        "automatic_spend_atoms": 0,
        "composed_by": "btx-model (this helper has no showmodel)",
    }


def cmd_ls(sock: str, args: list[str]) -> None:
    """`ollama ls` / Transmission list: getmodeltransfers."""
    incomplete = False
    for arg in args:
        if arg in ("--incomplete", "--downloading"):
            incomplete = True
        else:
            _die("ls takes no arguments except --incomplete; use 'search TEXT' to look beyond this node", 2)
    result = rpc(sock, "getmodeltransfers", [])
    if incomplete:
        if not isinstance(result, dict):
            _die("ls --incomplete: getmodeltransfers did not return an object")
        rows = result.get("transfers") if isinstance(result.get("transfers"), list) else []
        kept: list[Any] = []
        for row in rows:
            if not isinstance(row, dict):
                continue
            state = str(row.get("state") or "")
            pct = _as_int(row.get("percent"))
            if state == "downloading" or (pct is not None and pct < 100):
                kept.append(row)
        result["transfers"] = kept
        result["count"] = len(kept)
        result["filter"] = "incomplete"
        result["automatic_spend_atoms"] = 0
        result.setdefault(
            "note",
            "incomplete is this node's download view; resume is still an explicit pull/get FREE_ONLY",
        )
    _print(result, "getmodeltransfers")


