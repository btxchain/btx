        _die(f"check: no such file or directory: {path}", 2)
    result, err = _rpc_any(sock, "qualifymodel", [[resolved], [path]])
    if result is None:
        if not _missing_method(err):
            _die(f"qualifymodel: {_err_text(err)}")
        _die("check: this helper has no qualifymodel; structure checks are helper-side")
    if not isinstance(result, dict):
        _print(result, "qualifymodel")
        return
    result.setdefault("path", resolved)
    result["weights_hashed"] = False
    result["runtime_started"] = False
    result.setdefault("automatic_spend_atoms", 0)
    result.setdefault("next_actions", [f"preview {path}", f"host {path}"])
    _print(result, "check")


def cmd_pins(sock: str, args: list[str]) -> None:
    """`ipfs pin ls` analog: local keep/serve state, filtered by type.

    Pure view over `listmodels`; it is this node's observation, never a global
    count and never consensus.
    """
    kind = "pinned"
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--type":
            if i + 1 >= len(args):
                _die("pins --type requires pinned, seeded, or both", 2)
            kind = args[i + 1].strip().lower()
            i += 2
            continue
        elif a.startswith("--type="):
            kind = a.split("=", 1)[1].strip().lower()
            i += 1
            continue
        elif a.startswith("-"):
            _die(f"pins: unknown argument {a!r}", 2)
        else:
            _die("pins takes no positional arguments; usage: pins [--type pinned|seeded|both]", 2)
        i += 1
    if kind not in ("pinned", "seeded", "both"):
        _die("pins --type must be pinned, seeded, or both", 2)
    rows = _local_rows(sock)

    def keep(row: dict[str, Any]) -> bool:
        pinned = bool(row.get("pinned"))
        seeded = bool(row.get("seeded"))
        if kind == "pinned":
            return pinned
        if kind == "seeded":
            return seeded
        return pinned or seeded

    selected = [row for row in rows if keep(row)]
    _print(
        {
            "schema_version": 2,
            "type": kind,
            "count": len(selected),
            "models": selected,
            "automatic_spend_atoms": 0,
            "note": "local keep/serve observation of this node; not a global count, not consensus",
            "next_actions": ["transfers", "show <name>", "unhost <name>"],
        },
        "pins",
    )


