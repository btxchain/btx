def cmd_follow(sock: str, args: list[str]) -> None:
    if not args:
        _die(
            "follow requires publisher|collection ID "
            "[--action notify|free-download|prepare-funding]",
            2,
        )
    kind = args[0].strip().lower()
    if kind not in ("publisher", "collection"):
        _die("follow: first argument must be publisher or collection", 2)
    opts, pos = _take_opts(args[1:], {"--action"})
    if not pos:
        _die(f"follow {kind} requires an id", 2)
    if len(pos) != 1:
        _die("follow: extra positional arguments", 2)
    target = pos[0]
    action_raw = str(opts.get("--action") or "notify").strip().lower()
    if action_raw in ("fund", "fund-with-mandate", "fund_with_mandate"):
        _die(
            "follow: FUND_WITH_MANDATE is not a follow action; default is NOTIFY. "
            "PREPARE_FUNDING is unsigned and never spends. automatic_spend_atoms stays 0",
            2,
        )
    if action_raw not in _FOLLOW_ACTIONS:
        _die(
            "follow --action must be notify, free-download, or prepare-funding "
            "(default notify; never auto-spend)",
            2,
        )
    action = _FOLLOW_ACTIONS[action_raw]
    method = "watchmodelpublisher" if kind == "publisher" else "watchmodelcollection"
    id_key = "publisher_id" if kind == "publisher" else "collection_id"
    payload = {
        id_key: target,
        "action": action,
        "automatic_spend_atoms": 0,
    }
    _refuse_spend_options(payload, "follow")
    result = _rpc_dev(
        sock,
        method,
        [[payload], [target, action], [target, {"action": action}]],
    )
    src = result if isinstance(result, dict) else {}
    _emit_dev(
        "model_watch",
        method,
        result,
        {
            "watch_kind": kind,
            "publisher_id": _pick(src, "publisher_id") or (target if kind == "publisher" else None),
            "collection_id": _pick(src, "collection_id") or (target if kind == "collection" else None),
            "action": _pick(src, "action") or action,
            "watch_id": _pick(src, "watch_id", "id"),
            "filesystem_watch": False,
        },
        note=(
            "publisher/collection watch is not the filesystem -modelwatch drop folder. "
            "Default action is NOTIFY. FREE_DOWNLOAD uses existing FREE_ONLY getmodel. "
            "PREPARE_FUNDING is an unsigned plan. automatic_spend_atoms stays 0. "
            + DEV348_NOTE
        ),
        next_actions=["events", "events --cursor 0"],
    )


def cmd_events(sock: str, args: list[str]) -> None:
    opts, pos = _take_opts(args, {"--cursor", "--wait"})
    if pos:
        _die("events takes no positional arguments (use --cursor / --wait)", 2)
    cursor_raw = opts.get("--cursor")
    wait_raw = opts.get("--wait")
    cursor: int | None = None
    if cursor_raw is not None and str(cursor_raw).strip() != "":
        n = _as_int(cursor_raw)
        if n is None or n < 0:
            _die("events --cursor requires a non-negative integer", 2)
        cursor = n
    wait_s: float | None = None
    if wait_raw is not None and str(wait_raw).strip() != "":
        try:
            wait_s = float(wait_raw)
        except (TypeError, ValueError):
            _die("events --wait requires seconds (number)", 2)
        if wait_s < 0:
            _die("events --wait must be >= 0", 2)
        if wait_s == 0:
            wait_s = None
    query: dict[str, Any] = {
        "cursor": cursor,
        "wait_s": None,
        "automatic_spend_atoms": 0,
    }
    # Probe getmodelevents first so --wait cannot hang on an unknown RPC.
    listed = _rpc_dev(sock, "getmodelevents", [[query], [cursor], []])
    waited = None
    method = "getmodelevents"
    if wait_s is not None:
        wait_query = dict(query)
        wait_query["wait_s"] = wait_s
        wait_query["timeout_s"] = wait_s
        waited = _rpc_dev(
            sock,
            "waitformodelevent",
            [[wait_query], [cursor, wait_s], [wait_s]],
            timeout=float(wait_s) + 5.0,
        )
        method = "waitformodelevent"
        listed = waited if waited is not None else listed
    src = listed if isinstance(listed, dict) else {}
    events = src.get("events") if isinstance(src.get("events"), list) else None
    _emit_dev(
        "model_events",
        method,
        listed,
        {
            "cursor": _pick(src, "cursor", "local_sequence", "next_cursor") if cursor is None else cursor,
            "wait_s": wait_s,
            "next_cursor": _pick(src, "next_cursor", "local_sequence"),
            "events": events,
            "event_count": len(events) if events is not None else None,
            "waited": waited is not None,
        },
        note=(
            "events are local observations (journal), not consensus. "
            "Reorgs emit corrective events; they are not silent deletes. "
            + DEV348_NOTE
        ),
        next_actions=["events --cursor <next>", "follow publisher <id>"],
    )


