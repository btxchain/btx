def cmd_files(sock: str, args: list[str]) -> None:
    """aria2 metalink / qBittorrent content tab: per-file size + sha384.

    The list comes from the stored manifest of a *local* model. This is a read of
    helper state, not a re-hash, not a download, and never a runtime start.
