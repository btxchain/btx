def _die(msg: str, code: int = 1) -> None:
    if JSON_MODE:
        json.dump(
            {
                "schema_version": CLI_SCHEMA_VERSION,
                "ok": False,
                "available": False,
                "error": msg,
                "automatic_spend_atoms": 0,
            },
            sys.stdout,
            indent=2,
            ensure_ascii=False,
        )
        sys.stdout.write("\n")
    else:
        print(f"btx-model: {msg}", file=sys.stderr)
    raise SystemExit(code)


def _looks_like_socket(arg: str) -> bool:
    if arg in VERBS or arg in ("help", "-h", "--help"):
        return False
    if arg.startswith("-"):
        return False
    if arg.endswith(".sock") or arg.endswith("modeld.sock"):
        return True
    return "/" in arg or arg in (".", "..") or arg.startswith(".")


def _resolve_path(path: str) -> str:
    expanded = os.path.expanduser(path)
    if os.path.exists(expanded):
        return os.path.realpath(expanded)
    return os.path.abspath(expanded)


def _is_forbidden_helper_socket(path: str) -> bool:
    resolved = _resolve_path(path).replace("\\", "/")
    return any(marker in resolved for marker in _FORBIDDEN_SOCKET_MARKERS)


def _parse_argv(argv: list[str]) -> tuple[str, str, list[str], bool]:
    """Return (socket, verb, verb_args, used_default_socket)."""
    global JSON_MODE
    # Design name is MODELD_SOCK (reference clients). BTX_MODELD_SOCKET is an alias.
    socket_path = (
        os.environ.get("MODELD_SOCK", "").strip()
        or os.environ.get("BTX_MODELD_SOCKET", "").strip()
    )
    from_flag = False
    json_mode = False
    rest: list[str] = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help", "help"):
            JSON_MODE = json_mode
            return "", "help", [], False
        if a in ("--json",):
            json_mode = True
            i += 1
            continue
        if a == "--socket":
            if i + 1 >= len(argv):
                JSON_MODE = json_mode
                _die("--socket requires a path", 2)
            socket_path = argv[i + 1]
            from_flag = True
            i += 2
            continue
        if a.startswith("--socket="):
            socket_path = a.split("=", 1)[1]
            from_flag = True
            i += 1
            continue
        rest.append(a)
        i += 1
    cleaned: list[str] = []
    for a in rest:
        if a == "--json":
            json_mode = True
        else:
            cleaned.append(a)
    rest = cleaned
    JSON_MODE = json_mode

    if rest and _looks_like_socket(rest[0]) and not from_flag:
        socket_path = rest[0]
        rest = rest[1:]

    used_default = False
    if not socket_path:
        socket_path = DEFAULT_SOCKET
        used_default = True

    if not rest:
        _die("missing verb" if JSON_MODE else "missing verb\n" + USAGE, 2)
    verb = rest[0]
    if verb not in VERBS:
        _die(f"unknown verb {verb!r}" if JSON_MODE else f"unknown verb {verb!r}\n" + USAGE, 2)
    return socket_path, verb, rest[1:], used_default


def _loads_maybe(text: str) -> Any:
    stripped = text.strip()
    if stripped[:1] in "{[":
        try:
            return json.loads(stripped)
        except json.JSONDecodeError as e:
            _die(f"invalid JSON argument: {e}")
    return text


def _refuse_unsafe_path(path: str) -> None:
    low = path.lower()
    for suffix in UNSAFE_SUFFIXES:
        if low.endswith(suffix):
            _die(f"refusing {suffix} path (no pickle/.pt execution, no inference): {path}")


def _refuse_spend_options(obj: Any, where: str) -> None:
    if not isinstance(obj, dict):
        return
    if obj.get("auto_pay") not in (None, False, 0, "0"):
        _die(f"{where}: refusing auto_pay")
    spend = obj.get("automatic_spend_atoms", obj.get("automatic_spend"))
    if spend is None:
        return
    try:
        n = int(spend)
    except (TypeError, ValueError):
        _die(f"{where}: automatic_spend_atoms must be 0")
    if n != 0:
        _die(f"{where}: automatic_spend_atoms must be 0 (got {spend!r})")


def _read_draft_terms(path: str, where: str) -> dict[str, Any]:
    """Read a local BountyTerms JSON object from a file.

    Untrusted data: the bytes are parsed as strict JSON and forwarded only as
    createbountydraft terms. They are never executed, never inferred, never
    hashed as model weights, and never a shell command or filesystem plan.
    """
    if not path:
        _die(f"{where}: empty draft file path", 2)
    _refuse_unsafe_path(path)
    resolved = _resolve_path(path)
    if not os.path.isfile(resolved):
        _die(f"{where}: not a regular file: {path}", 2)
    try:
        size = os.path.getsize(resolved)
    except OSError as e:
        _die(f"{where}: stat {path}: {e}")
    if size == 0:
        _die(f"{where}: draft file is empty: {path}", 2)
    if size > MAX_DRAFT_FILE_BYTES:
        _die(
            f"{where}: draft file is {size} bytes > {MAX_DRAFT_FILE_BYTES}; "
            "BountyTerms is small JSON, model weights are never read as terms"
        )
    try:
        with open(resolved, "r", encoding="utf-8-sig") as fh:
            text = fh.read(MAX_DRAFT_FILE_BYTES + 1)
    except (OSError, UnicodeDecodeError) as e:
        _die(f"{where}: read {path}: {e}")
    try:
        loaded = json.loads(text)
    except json.JSONDecodeError as e:
        _die(f"{where}: {path} is not JSON: {e}")
    terms = loaded
    if isinstance(loaded, dict) and isinstance(loaded.get("terms"), dict):
        terms = loaded["terms"]
    if not isinstance(terms, dict):
        _die(f"{where}: {path} must contain a BountyTerms JSON object")
    return terms


def _walk_fail_closed(obj: Any, where: str) -> None:
    if isinstance(obj, dict):
        if obj.get("inference") or obj.get("runtime_exec") or obj.get("runtime_started"):
            _die(f"{where}: helper result started inference/runtime; fail closed")
        _refuse_spend_options(obj, where)
        for v in obj.values():
            _walk_fail_closed(v, where)
    elif isinstance(obj, list):
        for v in obj:
            _walk_fail_closed(v, where)


def _try_rpc(
    sock: str,
    method: str,
    params: list[Any] | None = None,
    *,
    timeout: float = DEFAULT_TIMEOUT_S,
) -> tuple[Any, Any]:
    """One JSON line over the helper socket.

    Returns (result, None), or (None, error_object) when the helper answers with
    a JSON-RPC error. Transport problems still die: a socket that never answered
    leaves nothing to fall back to.
    """
    if _is_forbidden_helper_socket(sock):
        _die(
            f"refusing production helper socket {sock!r}; "
            "set MODELD_SOCK or BTX_MODELD_SOCKET to a scratch path under ./e2e-scratch"
        )
    if not os.path.exists(sock):
        _die(f"socket not found: {sock} (scratch helper only; will not use a production path)")

    payload = {
        "jsonrpc": "1.0",
        "id": 1,
        "method": method,
        "params": params if params is not None else [],
    }
    line = json.dumps(payload, separators=(",", ":"), ensure_ascii=False) + "\n"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.settimeout(min(float(timeout), CONNECT_TIMEOUT_S))
        try:
            s.connect(sock)
        except OSError as e:
            _die(f"connect {sock}: {e} (fail closed)")
        s.settimeout(float(timeout))
        s.sendall(line.encode("utf-8"))
        try:
            s.shutdown(socket.SHUT_WR)
        except OSError:
            pass
        data = b""
        while True:
            try:
                chunk = s.recv(65536)
            except TimeoutError:
                _die(f"{method}: timeout after {timeout}s")
            if not chunk:
                break
            data += chunk
            if b"\n" in data:
                break
    finally:
        s.close()

    if not data:
        _die(f"{method}: empty reply (fail closed)")
    try:
        reply = json.loads(data.decode("utf-8"))
    except json.JSONDecodeError as e:
        _die(f"{method}: invalid JSON reply: {e}")
    if not isinstance(reply, dict):
        _die(f"{method}: reply is not an object")
    err = reply.get("error")
    if err not in (None, {}, []):
        return None, err
    result = reply.get("result")
    _walk_fail_closed(result, method)
    return result, None


def rpc(sock: str, method: str, params: list[Any] | None = None, *, timeout: float = DEFAULT_TIMEOUT_S) -> Any:
    result, err = _try_rpc(sock, method, params, timeout=timeout)
    if err is not None:
        _die(f"{method}: {_err_text(err)}")
    return result


def _err_text(err: Any) -> str:
    if isinstance(err, dict):
        code = err.get("code") or err.get("error") or ""
        msg = err.get("message") or err.get("reason") or ""
        text = ": ".join(str(x) for x in (code, msg) if x)
        return text or json.dumps(err, ensure_ascii=False)
    return str(err)


def _missing_method(err: Any) -> bool:
    text = _err_text(err).lower()
    return "method_not_found" in text or "unknown model rpc" in text


def _invalid_parameter(err: Any) -> bool:
    return "invalid_parameter" in _err_text(err).lower()


def _rpc_any(
    sock: str,
    method: str,
    variants: list[list[Any]],
    *,
    timeout: float = DEFAULT_TIMEOUT_S,
) -> tuple[Any, Any]:
    """Call one method with a few plausible param shapes.

    Returns the first non-INVALID_PARAMETER answer, so a helper without the verb
    fails closed on METHOD_NOT_FOUND instead of the CLI guessing forever.
    """
    last: Any = None
    for params in variants:
        result, err = _try_rpc(sock, method, params, timeout=timeout)
        if err is None:
            return result, None
        last = err
        if _missing_method(err) or not _invalid_parameter(err):
            return None, err
    return None, last


def _next_actions(result: Any, where: str) -> list[str]:
    """Helper next_actions are operator hints. Validate shape; never execute."""
    if not isinstance(result, dict) or "next_actions" not in result:
        return []
    actions = result["next_actions"]
    if not isinstance(actions, list) or any(not isinstance(a, str) for a in actions):
        _die(f"{where}: next_actions must be a list of strings: {actions!r}")
    return list(actions)


def _first_btx_token(text: str) -> str:
    """First btx:// token in copy_text, a .btx card, or a pasted URI."""
    pos = text.find(_BTX_URI_PREFIX)
    if pos < 0:
        return ""
    end = pos + len(_BTX_URI_PREFIX)
    # Stop at JSON/CSV/quote delimiters too, so a .btx card's `"uri": "btx://…",`
    # does not pick up the closing quote.
    while end < len(text) and not text[end].isspace() and text[end] not in ",\"'`<>()[]{}|":
        end += 1
    return text[pos:end]


def _looks_like_model_id(text: str) -> bool:
    s = text.strip()
    return len(s) == _MODEL_ID_HEX_LEN and all(c in "0123456789abcdefABCDEF" for c in s)


def _as_int(value: Any) -> int | None:
    if isinstance(value, bool) or value is None:
        return None
    if isinstance(value, int):
        return value
    if isinstance(value, float):
        return int(value)
    if isinstance(value, str) and value.strip().lstrip("-").isdigit():
        return int(value.strip())
    return None


def _first_int(*values: Any) -> int | None:
    for value in values:
        n = _as_int(value)
        if n is not None:
            return n
    return None


def _read_share_file(path: str, where: str) -> str:
    resolved = _resolve_path(path)
    if not os.path.isfile(resolved):
        _die(f"{where}: not a regular file: {path}", 2)
    try:
        size = os.path.getsize(resolved)
    except OSError as e:
        _die(f"{where}: stat {path}: {e}")
    if size > MAX_SHARE_FILE_BYTES:
        _die(f"{where}: {path} is {size} bytes, too large to be a share card")
    try:
        with open(resolved, "r", encoding="utf-8-sig", errors="replace") as fh:
            return fh.read(MAX_SHARE_FILE_BYTES)
    except OSError as e:
        _die(f"{where}: read {path}: {e}")


def _share_token(source: str, where: str) -> str:
    """A share card is a btx:// token, copy_text, or a small .btx/JSON/TXT file.

    Untrusted data: the text is only searched for a btx:// token. It is never a
    path, a shell command, an RPC payload, or a model file.
    """
    if source == "-":
        text = sys.stdin.read()
    elif source.lower().endswith(_SHARE_FILE_SUFFIXES) or os.sep in source:
        if not os.path.isfile(_resolve_path(source)):
            _die(f"{where}: no such share card: {source}", 2)
        if not source.lower().endswith(_SHARE_FILE_SUFFIXES):
            _die(f"{where}: {source} is not a .btx/JSON/TXT share card")
        text = _read_share_file(source, where)
    else:
        text = source
    token = _first_btx_token(text)
    if not token:
        _die(f"{where}: no btx:// token; pass copy_text, a .btx card, or - for stdin", 2)
    return token


def _alias_rows(sock: str) -> list[dict[str, Any]]:
    result, _err = _try_rpc(sock, "getmodelaliases", [])
    if not isinstance(result, dict):
        return []
    return [r for r in (result.get("aliases") or []) if isinstance(r, dict)]


def _local_rows(sock: str) -> list[dict[str, Any]]:
    result, _err = _try_rpc(sock, "listmodels", [])
    if not isinstance(result, dict):
        return []
    return [r for r in (result.get("models") or []) if isinstance(r, dict)]


def _search_cards(sock: str, text: str = "") -> list[dict[str, Any]]:
    query: dict[str, Any] = {"scope": "LOCAL"}
    if text:
        query["text"] = text
    result, _err = _try_rpc(sock, "searchmodels", [query])
    if not isinstance(result, dict):
        return []
    return [c for c in (result.get("results") or []) if isinstance(c, dict)]


def _live_jobs(sock: str) -> list[dict[str, Any]]:
    result, _err = _try_rpc(sock, "getmodeljob", [])
    if not isinstance(result, dict):
        return []
    return [j for j in (result.get("jobs") or []) if isinstance(j, dict)]


def _resolve_user(sock: str, ref: str) -> dict[str, Any]:
    """Resolve a user-typed model reference the way `ollama pull NAME` does.

    Order: btx:// token, model id, local alias, local search name, local label.
    All lookups are LOCAL. Unresolved stays unresolved so the caller can hand the
    raw text to the helper (newer helpers resolve aliases on their side too).
    """
    token = _first_btx_token(ref)
    if token:
        return {"input": ref, "uri": token, "model_id": "", "how": "uri"}
    if _looks_like_model_id(ref):
        return {"input": ref, "uri": "", "model_id": ref, "how": "model_id"}
    low = ref.strip().lower()
    for row in _alias_rows(sock):
        if str(row.get("alias") or "").strip().lower() == low:
            return {
                "input": ref,
                "uri": str(row.get("uri") or ""),
                "model_id": str(row.get("model_id") or ""),
                "alias": str(row.get("alias") or ""),
                "how": "alias",
            }
    for card in _search_cards(sock):
        names = [str(card.get("name") or "")] + [str(a) for a in (card.get("aliases") or [])]
        if any(n.strip() and n.strip().lower() == low for n in names):
            return {
                "input": ref,
                "uri": str(card.get("uri") or ""),
                "model_id": str(card.get("model_id") or ""),
                "how": "name",
            }
    for row in _local_rows(sock):
        if str(row.get("label") or "").strip().lower() == low:
            return {
                "input": ref,
                "uri": str(row.get("uri") or ""),
                "model_id": str(row.get("model_id") or ""),
                "how": "label",
            }
    return {"input": ref, "uri": "", "model_id": "", "how": "unresolved"}


def _target(resolved: dict[str, Any]) -> str:
    return str(resolved.get("uri") or resolved.get("model_id") or resolved.get("input") or "")


def _row_for(resolved: dict[str, Any], rows: list[dict[str, Any]]) -> dict[str, Any] | None:
    uri = str(resolved.get("uri") or "")
    mid = str(resolved.get("model_id") or "")
    for row in rows:
        if uri and str(row.get("uri") or "") == uri:
            return row
        if mid and str(row.get("model_id") or "") == mid:
            return row
    return None


def _aliases_for(sock: str, resolved: dict[str, Any], row: dict[str, Any] | None) -> list[str]:
    mid = str((row or {}).get("model_id") or resolved.get("model_id") or "")
    uri = str((row or {}).get("uri") or resolved.get("uri") or "")
    out = set()
    for alias in _alias_rows(sock):
        if mid and str(alias.get("model_id") or "") == mid:
            out.add(str(alias.get("alias")))
        elif uri and str(alias.get("uri") or "") == uri:
            out.add(str(alias.get("alias")))
    out.discard("")
    return sorted(out)


def _safe_filename(name: str) -> str:
    cleaned = "".join(c if (c.isalnum() or c in "-._") else "-" for c in name.strip())
    return cleaned.strip("-.") or "model"


def _share_preview(sock: str, source: str, where: str) -> dict[str, Any]:
    """openmodelshare preview, falling back to openbtxuri on an older helper.

    Preview only: no fetch, no inference, no wallet, no spend.
    """
    token = _share_token(source, where)
    result, err = _rpc_any(sock, "openmodelshare", [[source], [token]])
    degraded = ""
    if result is None:
        if not _missing_method(err):
            _die(f"{where}: {_err_text(err)}")
        result = rpc(sock, "openbtxuri", [token])
        degraded = "helper has no openmodelshare; used openbtxuri"
    if not isinstance(result, dict):
        _die(f"{where}: helper reply is not an object")
    card, _cerr = _try_rpc(sock, "getmodelsharecard", [token])
    if isinstance(card, dict):
        result.setdefault("share_card", card)
    actions = [a for a in (result.get("next_actions") or []) if isinstance(a, str)]
    for step in (
        f"getmodel {token} FREE_ONLY",
        f"getmodelsharecard {token}",
        f"exportmodellink {token}",
    ):
        if step not in actions:
            actions.append(step)
    result["next_actions"] = actions
    result["preview_only"] = True
    result["weights_hashed"] = False
    result["hosted"] = False
    if degraded:
        result["degraded"] = degraded
    return result


