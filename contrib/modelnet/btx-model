# --- 0.34.8-dev: cloud / follow / events / mirror / profile -----------------
# Fail immediately on METHOD_NOT_FOUND. Do not hang. automatic_spend_atoms=0.
# Raw secrets never on argv. Helper result is wrapped; unknown fields stay null.

_CLOUD_PROVIDERS = ("AUTO", "GENERIC_S3", "AWS_S3", "CLOUDFLARE_R2", "MINIO")
_CLOUD_LAYOUTS = ("AUTO", "SOURCE_FILES", "PIECE_OBJECTS")
_CLOUD_READ = ("AUTO", "STREAM_FILE", "PIECE_GET")
_FOLLOW_ACTIONS = {
    "notify": "NOTIFY",
    "free-download": "FREE_DOWNLOAD",
    "free_download": "FREE_DOWNLOAD",
    "prepare-funding": "PREPARE_FUNDING",
    "prepare_funding": "PREPARE_FUNDING",
}
_PROFILES = ("personal", "infrastructure", "mirror", "custom")
_FORBIDDEN_SECRET_FLAGS = (
    "--secret",
    "--password",
    "--secret-access-key",
    "--aws-secret-access-key",
    "--access-key-secret",
    "--access-key",
    "--aws-secret",
)
_SECRET_KEY_NEEDLES = (
    "secret",
    "password",
    "passwd",
    "private_key",
    "secret_access_key",
    "session_token",
    "api_key",
    "auth_token",
    "credential_value",
    "aws_secret",
)


def _is_secret_key(key: str) -> bool:
    k = str(key).lower().replace("-", "_")
    if k in ("credential_ref", "credential_refs"):
        return False
    return any(n in k for n in _SECRET_KEY_NEEDLES)


def _redact_secrets(obj: Any) -> Any:
    if isinstance(obj, dict):
        out: dict[str, Any] = {}
        for k, v in obj.items():
            if _is_secret_key(str(k)):
                out[str(k)] = None
            else:
                out[str(k)] = _redact_secrets(v)
        return out
    if isinstance(obj, list):
        return [_redact_secrets(v) for v in obj]
    return obj


def _rpc_dev(
    sock: str,
    method: str,
    variants: list[list[Any]] | None = None,
    *,
    timeout: float = DEFAULT_TIMEOUT_S,
) -> Any:
    """Call one 0.34.8-dev RPC. METHOD_NOT_FOUND dies immediately (no hang)."""
    params_list = variants if variants is not None else [[]]
    result, err = _rpc_any(sock, method, params_list, timeout=timeout)
    if result is not None:
        return result
    if _missing_method(err):
        _die(f"{method}: method not found ({DEV348_NOTE})")
    _die(f"{method}: {_err_text(err)}")


def _take_opts(
    args: list[str],
    valued: set[str],
    boolean: set[str] | None = None,
) -> tuple[dict[str, Any], list[str]]:
    boolean = boolean or set()
    opts: dict[str, Any] = {}
    pos: list[str] = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            pos.extend(args[i + 1 :])
            break
        low = a.split("=", 1)[0] if a.startswith("--") else a
        if low in _FORBIDDEN_SECRET_FLAGS or any(a.startswith(f + "=") for f in _FORBIDDEN_SECRET_FLAGS):
            _die(
                "refusing raw secret on argv; use --credential-ref env:NAME "
                "or --secret-file PATH (contents are never copied onto argv)",
                2,
            )
        name = a.split("=", 1)[0] if a.startswith("--") else ""
        if name in boolean:
            if "=" in a:
                val = a.split("=", 1)[1].strip().lower()
                opts[name] = val not in ("0", "false", "no", "off")
            else:
                opts[name] = True
            i += 1
            continue
        if name in valued:
            if "=" in a:
                opts[name] = a.split("=", 1)[1]
            else:
                if i + 1 >= len(args):
                    _die(f"{name} requires a value", 2)
                opts[name] = args[i + 1]
                i += 1
            i += 1
            continue
        if a.startswith("-"):
            _die(f"unknown argument {a!r}", 2)
        pos.append(a)
        i += 1
    return opts, pos


def _pick(src: Any, *keys: str) -> Any:
    if not isinstance(src, dict):
        return None
    for key in keys:
        if key in src and src[key] is not None:
            return src[key]
    return None


def _emit_dev(
    kind: str,
    method: str,
    result: Any,
    fields: dict[str, Any],
    *,
    note: str,
    next_actions: list[str],
) -> None:
    redacted = _redact_secrets(result) if result is not None else None
    obj: dict[str, Any] = {
        "schema_version": CLI_SCHEMA_VERSION,
        "kind": kind,
        "client": "btx-model",
        "client_version": "0.34.8-dev",
        "released": False,
        "ok": True,
        "available": True,
        "method": method,
        "error": None,
    }
    for key, value in fields.items():
        obj[key] = value
    obj["result"] = redacted
    obj["note"] = note
    obj["next_actions"] = next_actions
    obj["automatic_spend_atoms"] = 0
    _refuse_spend_options(obj, kind)
    _print(obj, method)


