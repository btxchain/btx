                "bucket": _pick(src, "bucket"),
                "prefix": _pick(src, "prefix"),
                "region": _pick(src, "region"),
                "layout": _pick(src, "layout", "cloud_object_layout"),
                "read_strategy": _pick(src, "read_strategy", "cloud_read_strategy"),
                "credential_ref": _pick(src, "credential_ref"),
                "reachable": _pick(src, "reachable"),
                "auth_ok": _pick(src, "auth_ok", "auth"),
                "health": _pick(src, "health"),
            },
            note=(
                "cloud backing is optional; pieces remain the swarm unit. "
                "Secrets are never returned. " + DEV348_NOTE
            ),
            next_actions=["cloud test", "cloud add --endpoint … --bucket … --credential-ref env:BTX_CLOUD_CREDENTIAL"],
        )
        return
    if sub == "test":
        if rest:
            _die("cloud test takes no arguments", 2)
        result = _rpc_dev(sock, "testcloudstorage", [[], [{}]])
        src = result if isinstance(result, dict) else {}
        _emit_dev(
            "cloud_storage",
            "testcloudstorage",
            result,
            {
                "command": "test",
                "provider": _pick(src, "provider", "cloud_provider"),
                "endpoint": _pick(src, "endpoint"),
                "bucket": _pick(src, "bucket"),
                "prefix": _pick(src, "prefix"),
                "region": _pick(src, "region"),
                "layout": _pick(src, "layout", "cloud_object_layout"),
                "read_strategy": _pick(src, "read_strategy", "cloud_read_strategy"),
                "credential_ref": _pick(src, "credential_ref"),
                "reachable": _pick(src, "reachable"),
                "auth_ok": _pick(src, "auth_ok", "auth"),
                "health": _pick(src, "health"),
            },
            note=(
                "testcloudstorage is a local helper probe, not WAN evidence. "
                "Do not treat ok here as a production origin receipt. " + DEV348_NOTE
            ),
            next_actions=["cloud status"],
        )
        return
    if sub != "add":
        _die(f"cloud: unknown subcommand {sub!r} (add|test|status)", 2)
    valued = {
        "--endpoint",
        "--bucket",
        "--prefix",
        "--region",
        "--layout",
        "--provider",
        "--read-strategy",
        "--credential-ref",
        "--secret-file",
    }
    opts, pos = _take_opts(rest, valued, {"--allow-request-heavy-cloud-layout"})
    if pos:
        _die(f"cloud add: unexpected positional {pos[0]!r}; use flags only", 2)
    if opts.get("--credential-ref") and opts.get("--secret-file"):
        _die("cloud add: pass either --credential-ref or --secret-file, not both", 2)
    cred_ref: str | None = None
    cred_kind = "path"
    if opts.get("--credential-ref"):
        cred_ref = str(opts["--credential-ref"]).strip()
        if not cred_ref:
            _die("cloud add: --credential-ref is empty", 2)
        if cred_ref.startswith("env:"):
            cred_kind = "env"
            cred_ref = cred_ref[4:]
            if not cred_ref or not cred_ref.replace("_", "").isalnum():
                _die("cloud add: env credential name is invalid", 2)
        elif cred_ref.startswith("file:"):
            cred_ref = cred_ref[5:]
            cred_kind = "path"
        else:
            cred_kind = "path"
    secret_file = str(opts.get("--secret-file") or "").strip()
    if secret_file:
        _refuse_unsafe_path(secret_file)
        resolved = _resolve_path(secret_file)
        if not os.path.isfile(resolved):
            _die(f"cloud add: --secret-file is not a regular file: {secret_file}", 2)
        try:
            mode = os.stat(resolved).st_mode & 0o777
        except OSError as e:
            _die(f"cloud add: stat --secret-file: {e}")
        if mode & 0o077:
            _die(
                f"cloud add: --secret-file mode is {oct(mode)}; refuse world/group-readable "
                "(want 0600). Not reading the file onto argv.",
                2,
            )
        cred_ref = resolved
    endpoint = str(opts.get("--endpoint") or "").strip()
    bucket = str(opts.get("--bucket") or "").strip()
    if not endpoint or not bucket:
        _die("cloud add requires --endpoint and --bucket", 2)
    layout = str(opts.get("--layout") or "AUTO").strip().upper()
    provider = str(opts.get("--provider") or "AUTO").strip().upper()
    read_strategy = str(opts.get("--read-strategy") or "AUTO").strip().upper()
    if provider not in _CLOUD_PROVIDERS:
        _die(f"cloud add: --provider must be one of {', '.join(_CLOUD_PROVIDERS)}", 2)
    if layout not in _CLOUD_LAYOUTS:
        _die(f"cloud add: --layout must be one of {', '.join(_CLOUD_LAYOUTS)}", 2)
    if read_strategy not in _CLOUD_READ:
        _die(f"cloud add: --read-strategy must be one of {', '.join(_CLOUD_READ)}", 2)
    allow_heavy = bool(opts.get("--allow-request-heavy-cloud-layout"))
    prefix = str(opts.get("--prefix") or "").strip() or None
    region = str(opts.get("--region") or "").strip() or None
    cfg: dict[str, Any] = {
        "endpoint": endpoint,
        "bucket": bucket,
        "prefix": prefix,
        "region": region,
        "layout": layout,
        "cloud_object_layout": layout,
        "provider": provider,
        "cloud_provider": provider,
        "read_strategy": read_strategy,
        "cloud_read_strategy": read_strategy,
        "credential_ref": cred_ref,
        "credential_ref_kind": cred_kind,
        "allow_request_heavy_cloud_layout": allow_heavy,
        "automatic_spend_atoms": 0,
    }
    _refuse_spend_options(cfg, "cloud add")
    result = _rpc_dev(sock, "setcloudstorage", [[cfg]])
    src = result if isinstance(result, dict) else {}
    _emit_dev(
        "cloud_storage",
        "setcloudstorage",
        result,
        {
            "command": "add",
            "provider": _pick(src, "provider", "cloud_provider") or provider,
            "endpoint": _pick(src, "endpoint") or endpoint,
            "bucket": _pick(src, "bucket") or bucket,
            "prefix": _pick(src, "prefix") if _pick(src, "prefix") is not None else prefix,
            "region": _pick(src, "region") if _pick(src, "region") is not None else region,
            "layout": _pick(src, "layout", "cloud_object_layout") or layout,
            "read_strategy": _pick(src, "read_strategy", "cloud_read_strategy") or read_strategy,
            "credential_ref": _pick(src, "credential_ref") or cred_ref,
            "reachable": _pick(src, "reachable"),
            "auth_ok": _pick(src, "auth_ok", "auth"),
            "health": _pick(src, "health"),
        },
        note=(
            "setcloudstorage stores a local origin config. Credentials stay in the "
            "ref/file; they are not written to search records, events, or this JSON. "
            + DEV348_NOTE
        ),
