def _json_obj(args: list[str]) -> dict[str, Any]:
    if not args:
        return {}
    raw = args[0]
    if raw.startswith("@"):
        with open(raw[1:], "r", encoding="utf-8") as fh:
            obj = json.load(fh)
        if not isinstance(obj, dict):
            _die("JSON object required", 2)
        return obj
    obj = json.loads(raw)
    if not isinstance(obj, dict):
        _die("JSON object required", 2)
    return obj


