def main(argv: list[str] | None = None) -> None:
    argv = list(sys.argv[1:] if argv is None else argv)
    sock, verb, args, used_default = _parse_argv(argv)
    if verb == "help":
        sys.stdout.write(USAGE)
        return
    if used_default and not JSON_MODE:
        print(f"btx-model: socket {sock}", file=sys.stderr)
    if _is_forbidden_helper_socket(sock):
        _die(
            f"refusing production helper socket {sock!r}; "
            "set MODELD_SOCK or BTX_MODELD_SOCKET to a scratch path under ./e2e-scratch"
        )
    COMMANDS[verb](sock, args)


