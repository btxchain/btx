# LM Studio / Hugging Face catalog filters, named on the CLI. The RPC already
# accepts these; btx-model only stops the caller from hand-writing JSON.
# Integer flags land under `filters.*`, string flags under `filters.*`, and
# `--sort`/`--limit` are top-level query fields (ParseSearchQuery).
_SEARCH_INT_FILTERS = {
    "--min-size-bytes": "min_size_bytes",
    "--max-size-bytes": "max_size_bytes",
    "--min-providers": "min_provider_count",
    "--min-parameters": "min_parameters",
    "--max-parameters": "max_parameters",
}
_SEARCH_STR_FILTERS = {
    "--format": "format",
    "--quantization": "quantization",
    "--family": "family",
    "--architecture": "architecture",
    "--publisher": "publisher_name",
    "--state": "state",
    "--license": "license",
}


def _search_size_bytes(card: dict[str, Any]) -> int | None:
    """Signed `size_bytes` from a search card, else the nested economy copies."""
    nested = card.get("model") if isinstance(card.get("model"), dict) else {}
    entry = card.get("entry") if isinstance(card.get("entry"), dict) else {}
    entry_model = entry.get("model") if isinstance(entry.get("model"), dict) else {}
    return _first_int(card.get("size_bytes"), nested.get("size_bytes"), entry_model.get("size_bytes"))


def _filter_fits(sock: str, result: Any) -> Any:
    """LM Studio "fits my machine", read-only and local.

    A hit fits when its signed `size_bytes` is <= `checkmodelsetup.remaining_bytes`
    on this node. Storage only: BTX never runs inference, so this is not a RAM or
    VRAM claim. Unknown size or an unset quota is `null` and is dropped rather
    than guessed (`automatic_spend_atoms` stays 0).
    """
    if not isinstance(result, dict) or not isinstance(result.get("results"), list):
        return result
    doctor, _err = _try_rpc(sock, "checkmodelsetup", [])
    remaining = _as_int(doctor.get("remaining_bytes")) if isinstance(doctor, dict) else None
    quota = _as_int(doctor.get("quota")) if isinstance(doctor, dict) else None
    kept: list[Any] = []
    unknown = 0
    too_large = 0
    for card in result["results"]:
        if not isinstance(card, dict):
            continue
        size = _search_size_bytes(card)
        card["fits_remaining_bytes"] = remaining
        if remaining is None or remaining <= 0 or size is None:
            card["fits_storage"] = None
            unknown += 1
            continue
        card["fits_storage"] = bool(size <= remaining)
        if card["fits_storage"]:
            kept.append(card)
        else:
            too_large += 1
    result["results"] = kept
    result["results_returned"] = len(kept)
    result["fits"] = {
        "quota_bytes": quota,
        "remaining_bytes": remaining,
        "kept": len(kept),
        "dropped_too_large": too_large,
        "dropped_size_unknown": unknown,
        "basis": "this node's remaining model storage quota (payload bytes)",
        "inference": False,
        "note": "storage quota only; not a RAM/VRAM claim and not an inference capability",
    }
    result.setdefault("automatic_spend_atoms", 0)
    return result


def cmd_search(sock: str, args: list[str]) -> None:
    """LM Studio-ish catalog filters over searchmodels (default scope LOCAL).

    Flags map to fields ParseSearchQuery already accepts, so this is a caller
    convenience: no new helper state, no network beyond the requested scope, no
    spend, no inference. `--fits` compares signed sizes against this node's
    remaining storage quota and drops what does not fit.
    """
    scope = "LOCAL"
    text = ""
    extra: dict[str, Any] | None = None
    filters: dict[str, Any] = {}
    sort = ""
    limit: int | None = None
    fits = False
    i = 0
    while i < len(args):
        a = args[i]
        name = a.split("=", 1)[0] if a.startswith("--") else ""
        if name in _SEARCH_INT_FILTERS or name in _SEARCH_STR_FILTERS or name in ("--scope", "--sort", "--limit"):
            if "=" in a:
                value = a.split("=", 1)[1]
            else:
                if i + 1 >= len(args):
                    _die(f"search {name} requires a value", 2)
                value = args[i + 1]
                i += 1
            if name == "--scope":
                scope = value
            elif name == "--sort":
                sort = value
            elif name == "--limit":
                n = _as_int(value)
                if n is None or n <= 0:
                    _die("search --limit requires a positive integer", 2)
                limit = n
            elif name in _SEARCH_INT_FILTERS:
                n = _as_int(value)
                if n is None:
                    _die(f"search {name} requires an integer", 2)
                filters[_SEARCH_INT_FILTERS[name]] = n
            else:
                filters[_SEARCH_STR_FILTERS[name]] = value
            i += 1
            continue
        if a == "--fits":
            fits = True
            i += 1
            continue
        if a == "--locally-verified":
            filters["locally_verified"] = True
            i += 1
            continue
        loaded = _loads_maybe(a)
        if isinstance(loaded, dict):
            extra = loaded
            i += 1
            continue
        text = str(loaded)
        i += 1
    query: dict[str, Any] = {"scope": scope}
    if extra:
        query.update(extra)
        query.setdefault("scope", scope)
    if filters:
        merged = dict(filters)
        existing = query.get("filters")
        if isinstance(existing, dict):
            merged = {**existing, **merged}
        query["filters"] = merged
    if sort:
        query["sort"] = sort
    if limit is not None:
        query["limit"] = limit
    if text:
        query.setdefault("text", text)
    result = rpc(sock, "searchmodels", [query])
    if fits:
        result = _filter_fits(sock, result)
    _print(result, "searchmodels")


