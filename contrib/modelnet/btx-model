def cmd_link(sock: str, args: list[str]) -> None:
    """`qBittorrent .torrent`-style magnet file: canonical uri + copy_text only."""
    if not args:
        _die("link requires a model name, alias, id, or btx:// URI", 2)
    ref = args[0]
    out_path = ""
    to_stdout = False
    force = False
    i = 1
    while i < len(args):
        a = args[i]
        if a == "--stdout":
            to_stdout = True
            i += 1
            continue
        if a == "--force":
            force = True
            i += 1
            continue
        if a == "--out":
            if i + 1 >= len(args):
                _die("link --out requires a path", 2)
            out_path = args[i + 1]
            i += 2
            continue
        if a.startswith("--out="):
            out_path = a.split("=", 1)[1]
            i += 1
            continue
        if a.startswith("-"):
            _die(f"link: unknown argument {a!r}", 2)
        # Documented form: `link NAME ./name.btx`
        if out_path:
            _die(f"link: unexpected extra path {a!r}", 2)
        out_path = a
        i += 1
    variants: list[list[Any]] = []
    if out_path:
        # `exportmodellink ID PATH`: the path is a plain string parameter.
        variants.append([ref, out_path])
    variants.append([ref])
    result, err = _rpc_any(sock, "exportmodellink", variants)
    if result is not None:
        # The helper returns the card under `link`; hoist it so every caller sees
        # the same top-level uri/copy_text contract.
        if isinstance(result, dict) and isinstance(result.get("link"), dict):
            for key in ("uri", "copy_text", "family", "format", "quantization", "signed"):
                if result["link"].get(key) is not None:
                    result.setdefault(key, result["link"][key])
        _print(result, "exportmodellink")
        return
    if not _missing_method(err):
        _die(f"exportmodellink: {_err_text(err)}")
    doc = _composed_link_doc(sock, ref)
    if to_stdout:
        _print(doc, "exportmodellink")
        return
    if not out_path:
        out_path = _safe_filename(str(doc.get("name") or doc.get("model_id") or "model")) + ".btx"
    if out_path == "-":
        _print(doc, "exportmodellink")
        return
    resolved_path = _resolve_path(out_path)
    if os.path.exists(resolved_path) and not force:
        _die(f"link: {out_path} exists; pass --force to overwrite (or --stdout)")
    try:
        with open(resolved_path, "w", encoding="utf-8") as fh:
            json.dump(doc, fh, indent=2, ensure_ascii=False, sort_keys=False)
            fh.write("\n")
        written = os.path.getsize(resolved_path)
    except OSError as e:
        _die(f"link: write {out_path}: {e}")
    _print(
        {
            "schema_version": 2,
            "path": os.path.abspath(resolved_path),
            "uri": doc["uri"],
            "copy_text": doc["copy_text"],
            "bytes_written": written,
            "composed_by": "btx-model (this helper has no exportmodellink)",
            "next_actions": [
                f"open {out_path}",
                f"getmodel {doc['uri']} FREE_ONLY",
                "getmodeltransfers",
            ],
            "automatic_spend_atoms": 0,
            "note": "a .btx card is a share link, never weights",
        },
        "exportmodellink",
    )


def _composed_link_doc(sock: str, ref: str) -> dict[str, Any]:
    """.btx share document: canonical uri + copy_text, never a weight file."""
    resolved = _resolve_user(sock, ref)
    if resolved["how"] == "unresolved":
        _die(f"link {ref!r}: no local alias, model name, id, or btx:// URI; run 'btx-model ls'")
    share = rpc(sock, "getmodelsharecard", [_target(resolved)])
    share_obj = share.get("share") if isinstance(share.get("share"), dict) else {}
    uri = str(share_obj.get("uri") or resolved.get("uri") or "")
    if not uri:
        _die(f"link {ref!r}: helper returned no canonical uri; refusing to invent one")
    row = _row_for(resolved, _local_rows(sock))
    mid = str((row or {}).get("model_id") or resolved.get("model_id") or "")
    card = next((c for c in _search_cards(sock) if mid and str(c.get("model_id") or "") == mid), {})
    return {
        "schema_version": 2,
        "kind": "btx_model_share",
        "uri": uri,
        "copy_text": str(share_obj.get("copy_text") or uri),
        "model_id": mid,
        "name": str(card.get("name") or (row or {}).get("label") or resolved.get("alias") or ""),
        "family": share_obj.get("family"),
        "format": share_obj.get("format"),
        "quantization": share_obj.get("quantization"),
        "size_bytes": _first_int(share_obj.get("size_bytes"), (row or {}).get("bytes"), card.get("size_bytes")),
        "signed": bool(share_obj.get("signed")),
        "hint": "btx-model open FILE   # or: btx-cli getmodel URI FREE_ONLY",
        "automatic_spend_atoms": 0,
    }


def cmd_bounty_draft(sock: str, args: list[str]) -> None:
