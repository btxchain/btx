{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btx:spec:0347:bounty:FeedEvent:1",
  "title": "FeedEvent",
  "description": "Proposed strict shape contract. Semantic authorization and provenance checks remain mandatory.",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "event_type": {
      "enum": [
        "BOUNTY_PUBLISHED",
        "FUNDING_ROUND_FROZEN",
        "FUNDING_CONFIRMED",
        "SUBMISSION_COMMITTED",
        "SUBMISSION_REVEALED",
        "EVALUATION_REPORTED",
        "CHALLENGE_OPENED",
        "CHALLENGE_RESOLVED",
        "ACCEPTANCE_PUBLISHED",
        "AWARD_STAGED",
        "AWARD_CONFIRMED",
        "REFUND_ELIGIBLE",
        "REFUND_CONFIRMED",
        "SECRET_OBSERVED",
        "MODEL_PUBLICLY_OBSERVED",
        "CHAIN_OBSERVATION_REORGED"
      ]
    },
    "object_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "object_kind": {
      "type": "string",
      "maxLength": 64
    },
    "underlying_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{96}$"
      },
      "maxItems": 16
    },
    "published_at_ms": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "first_seen_at_ms": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "local_sequence": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "store_epoch": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chain_context": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "network_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "authority": {
              "enum": [
                "LOCAL_VALIDATED_CHAIN",
                "REMOTE_OBSERVATION",
                "UNKNOWN"
              ]
            },
            "tip_hash": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tip_height": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 499999999
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_at_ms": {
              "type": "string",
              "pattern": "^[0-9]+$"
            },
            "index_complete": {
              "type": "boolean"
            },
            "minimum_confirmations": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "observer_identity": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{96}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "network_id",
            "authority",
            "tip_hash",
            "tip_height",
            "observed_at_ms",
            "index_complete",
            "minimum_confirmations",
            "observer_identity"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "authority": {
      "enum": [
        "SIGNED_PUBLICATION",
        "LOCAL_OBSERVATION",
        "LOCAL_VALIDATED_CHAIN",
        "REMOTE_OBSERVATION"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "object_id",
    "object_kind",
    "underlying_record_ids",
    "published_at_ms",
    "first_seen_at_ms",
    "local_sequence",
    "store_epoch",
    "chain_context",
    "authority"
  ],
  "additionalProperties": false
}
