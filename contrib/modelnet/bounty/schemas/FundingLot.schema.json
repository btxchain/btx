{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btx:spec:0347:bounty:FundingLot:1",
  "title": "FundingLot",
  "description": "Proposed implementation contract. JSON schema validates shape; semantic authorization, deadlines, arithmetic, signatures and actual script compatibility are additional required checks.",
  "type": "object",
  "properties": {
    "lot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "round_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "terms_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "contributor_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "principal_atoms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})$",
      "description": "BTX atoms, additionally MoneyRange <= 2100000000000000 in semantic validation."
    },
    "fee_reserve_atoms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})$",
      "description": "BTX atoms, additionally MoneyRange <= 2100000000000000 in semantic validation."
    },
    "refund_public_key_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]+$",
      "minLength": 2624,
      "maxLength": 2624
    },
    "refund_script_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "escrow_tree_commitment": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outpoint": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "txid": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "vout": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          },
          "required": [
            "txid",
            "vout"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "refund_height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 499999999
    }
  },
  "required": [
    "lot_id",
    "round_id",
    "terms_id",
    "contributor_identity",
    "principal_atoms",
    "fee_reserve_atoms",
    "refund_public_key_hex",
    "refund_script_commitment",
    "escrow_tree_commitment",
    "outpoint",
    "refund_height"
  ],
  "additionalProperties": false
}
