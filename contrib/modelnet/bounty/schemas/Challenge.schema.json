{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btx:spec:0347:bounty:Challenge:1",
  "title": "Challenge",
  "description": "Proposed strict shape contract. Semantic authorization and provenance checks remain mandatory.",
  "type": "object",
  "properties": {
    "bounty_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "terms_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "submission_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "report_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{96}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "enum": [
        "ARTIFACT_MISMATCH",
        "SIGNATURE_INVALID",
        "WRONG_PROFILE",
        "ARITHMETIC",
        "ELIGIBILITY_CONFLICT",
        "SUBJECTIVE_REVIEW"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{96}$"
      },
      "maxItems": 16
    },
    "challenger_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    }
  },
  "required": [
    "bounty_id",
    "terms_id",
    "submission_id",
    "report_id",
    "category",
    "description",
    "evidence_ids",
    "challenger_identity"
  ],
  "additionalProperties": false
}
