{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btx:spec:0347:bounty:ModelSearchRecordV2:1",
  "title": "ModelSearchRecordV2",
  "description": "Proposed implementation contract. JSON schema validates shape; semantic authorization, deadlines, arithmetic, signatures and actual script compatibility are additional required checks.",
  "type": "object",
  "properties": {
    "record_version": {
      "const": 2
    },
    "model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "uri": {
      "type": "string",
      "pattern": "^btx://",
      "maxLength": 512
    },
    "publisher_identity": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "publisher_display_name": {
      "type": "string",
      "maxLength": 160
    },
    "canonical_name": {
      "type": "string",
      "maxLength": 160
    },
    "display_name": {
      "type": "string",
      "maxLength": 160
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      },
      "maxItems": 32
    },
    "family": {
      "type": "string",
      "maxLength": 128
    },
    "architecture": {
      "type": "string",
      "maxLength": 128
    },
    "parameter_count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "file_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65536
    },
    "format": {
      "type": "string",
      "maxLength": 64
    },
    "quantization": {
      "type": "string",
      "maxLength": 64
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 64
    },
    "modalities": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 16
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "maxItems": 64
    },
    "short_description": {
      "type": "string",
      "maxLength": 1024
    },
    "size_bytes": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "published_at_ms": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "updated_at_ms": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "release_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{96}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "bounty_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{96}$"
      },
      "maxItems": 16
    },
    "metadata_sequence": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "expires_at_ms": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "tombstone": {
      "type": "boolean"
    }
  },
  "required": [
    "record_version",
    "model_id",
    "artifact_id",
    "uri",
    "publisher_identity",
    "publisher_display_name",
    "canonical_name",
    "display_name",
    "aliases",
    "family",
    "architecture",
    "parameter_count",
    "file_count",
    "format",
    "quantization",
    "languages",
    "modalities",
    "tags",
    "short_description",
    "size_bytes",
    "published_at_ms",
    "updated_at_ms",
    "release_id",
    "bounty_ids",
    "metadata_sequence",
    "expires_at_ms",
    "tombstone"
  ],
  "additionalProperties": false
}
