          "enum": [
            "PENDING",
            "PAIRED",
            "REVOKED"
          ]
        },
        "account_ref": {
          "$ref": "#/$defs/Id"
        },
        "device_key_id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "device_id",
        "status",
        "account_ref",
        "device_key_id"
      ]
    },
    "NativeEconomicAction": {
      "type": "string",
      "enum": [
        "FUND_RELEASE",
        "FUND_BOUNTY",
        "CLAIM",
        "REFUND"
      ]
    },
    "ConversionQuote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "venue_quote_ref": {
          "$ref": "#/$defs/Id"
        },
        "source_asset": {
          "type": "string",
          "pattern": "^[A-Z0-9._-]{2,16}$"
        },
        "source_amount_minor": {
          "$ref": "#/$defs/UIntString"
        },
        "source_exponent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "target_btx_atoms": {
          "$ref": "#/$defs/UIntString"
        },
        "max_slippage_bps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "expires_at_ms": {
          "$ref": "#/$defs/UIntString"
        },
        "reverse_conversion_authorized": {
          "const": false
        }
      },
      "required": [
        "venue_quote_ref",
        "source_asset",
        "source_amount_minor",
        "source_exponent",
        "target_btx_atoms",
        "max_slippage_bps",
        "expires_at_ms",
        "reverse_conversion_authorized"
      ]
    }
  }
}
