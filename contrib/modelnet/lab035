WALLET_TOKENS = {
    "sendtoaddress",
    "sendmany",
    "getbalance",
    "walletpassphrase",
    "dumpprivkey",
    "importprivkey",
}


def path_problem(value: str) -> str | None:
    """Return BTX035_PATH_UNSAFE when value is an unsafe path or shell token."""
    if value is None or value.strip() == "":
        return None
    if "\x00" in value:
        return "BTX035_PATH_UNSAFE"
    if any(ch in value for ch in (";", "|", "&", "`", "$", "\n", "\r", "<", ">")):
        return "BTX035_PATH_UNSAFE"
    normalized = value.replace("\\", "/")
    parts = normalized.split("/")
    if any(part == ".." for part in parts):
        return "BTX035_PATH_UNSAFE"
    lower = normalized.lower()
    if lower == "rpc" or lower.startswith("/rpc") or "/shell" in lower or lower.endswith("/sh") or lower.endswith("/bash"):
        return "BTX035_PATH_UNSAFE"
    if "/bin/" in lower or lower.startswith("/bin"):
        return "BTX035_PATH_UNSAFE"
    leaf = parts[-1].lower() if parts else lower
    if leaf in WALLET_TOKENS or "wallet" in leaf:
        return "BTX035_PATH_UNSAFE"
    return None


def parse_args(argv: list[str]) -> tuple[str | None, dict[str, str], bool, list[str]]:
    as_json = False
    command = None
    flags: dict[str, str] = {}
    positionals: list[str] = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--json":
            as_json = True
        elif arg.startswith("--"):
            key = arg[2:].replace("-", "_")
            if i + 1 < len(argv) and not argv[i + 1].startswith("--"):
                flags[key] = argv[i + 1]
                i += 1
            else:
                flags[key] = "true"
        elif command is None:
            command = arg
        else:
            positionals.append(arg)
        i += 1
    return command, flags, as_json, positionals


def base_payload(command: str, spec: dict | None) -> dict:
    payload = {
        "command": command,
        "automatic_spend_atoms": "0",
        "contacts_peers": False if spec is None else bool(spec["contacts_peers"]),
        "executed_peer_contact": False,
        "planned": True,
        "no_spend": True,
    }
    if spec is not None:
        payload["effect"] = spec["effect"]
        payload["required_authority"] = spec["authority"]
    return payload


def spend_requested(flags: dict[str, str], positionals: list[str]) -> bool:
    if "spend" in flags or "wallet" in flags or "send" in flags:
        return True
    atoms = flags.get("automatic_spend_atoms")
    if atoms is not None and atoms != "0":
        return True
    for positional in positionals:
        if positional.lower() in WALLET_TOKENS or "wallet" in positional.lower():
            return True
    return False


def status_fields(flags: dict[str, str]) -> dict[str, str]:
    coverage = flags.get("coverage")
    if coverage is None or coverage.strip() == "":
        coverage = "gap"
    return {
        "source_commit": flags.get("source_commit") or "unknown",
        "snapshot": flags.get("snapshot") or "unknown",
        "signer": flags.get("signer") or "unknown",
        "coverage": coverage,
        "assurance": flags.get("assurance") or "unknown",
        "policy": flags.get("policy") or "unknown",
        "disputes": flags.get("disputes") or "unknown",
        "replicas": flags.get("replicas") or "unknown",
        "runtime_generation": flags.get("runtime_generation") or "unknown",
    }


def emit(payload: dict, as_json: bool, code: int) -> int:
    if code != 0:
        print(payload.get("error", "error"), file=sys.stderr)
    if as_json:
        print(json.dumps(payload, sort_keys=True))
    elif code == 0:
        print(payload.get("effect", payload["command"]))
    return code


def main(argv: list[str] | None = None) -> int:
    if argv is None:
        argv = sys.argv[1:]
    command, flags, as_json, positionals = parse_args(argv)
    if command is None or command not in COMMANDS:
        name = command or "unknown"
        payload = base_payload(name, None)
        payload["error"] = "BTX035_ROUTE"
        payload["contacts_peers"] = False
        return emit(payload, as_json, 2)

    spec = COMMANDS[command]
    payload = base_payload(command, spec)
    if spend_requested(flags, positionals):
        payload["error"] = "BTX035_SCOPE_DENIED"
        payload["automatic_spend_atoms"] = "0"
        payload["contacts_peers"] = False
        payload["executed_peer_contact"] = False
        return emit(payload, as_json, 2)

    for required in spec["required"]:
        if required not in flags or flags[required].strip() == "":
            payload["error"] = "BTX035_SCHEMA"
            payload["missing"] = required
            payload["checks"] = ["required_flags"]
            return emit(payload, as_json, 2)

    checked = []
    for key, value in flags.items():
        if key in {"automatic_spend_atoms", "trusted"}:
            continue
        problem = path_problem(value)
        checked.append(key)
        if problem == "BTX035_PATH_UNSAFE":
            payload["error"] = "BTX035_PATH_UNSAFE"
            payload["rejected_flag"] = key
            payload["checks"] = ["required_flags", "path_safety"]
            payload["path_safety"] = "rejected"
            return emit(payload, as_json, 2)

    payload["checks"] = ["required_flags", "path_safety", "no_spend"]
    payload["path_safety"] = "ok" if checked else "not_applicable"
    for key in spec["echo"]:
        payload[key] = flags[key]
    if command == "identity":
        payload["secret_returned"] = False
        payload["checks"] = ["required_flags", "path_safety", "no_secret_export", "no_spend"]
    if command == "status":
        payload.update(status_fields(flags))
        payload["checks"] = ["required_flags", "path_safety", "coverage_reported", "no_spend"]
        payload.pop("trusted", None)
    return emit(payload, as_json, 0)


if __name__ == "__main__":
    sys.exit(main())
