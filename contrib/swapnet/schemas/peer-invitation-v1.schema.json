{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btx:swapnet:peer-invitation-v1",
  "type": "object",
  "properties": {
    "body": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "network": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320
          }
        },
        "issued_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "network",
        "provider",
        "endpoints",
        "issued_at",
        "expires_at",
        "nonce"
      ],
      "additionalProperties": false
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384
    }
  },
  "required": [
    "body",
    "signature"
  ],
  "additionalProperties": false
}
