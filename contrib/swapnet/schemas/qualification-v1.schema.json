{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btx:swapnet:qualification-v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "log": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    },
    "complete": {
      "type": "boolean"
    },
    "production_authorized": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "checks",
    "complete",
    "production_authorized"
  ],
  "additionalProperties": false
}
