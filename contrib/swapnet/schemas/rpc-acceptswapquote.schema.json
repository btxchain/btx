{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:btx:swapnet:rpc-acceptswapquote",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "mandate_id": {
      "type": "string"
    },
    "max_local_fee_atoms": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,77})$"
    },
    "refund_fee_atoms": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "claim_fee_atoms": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,77})$"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "quote_id",
    "mandate_id",
    "max_local_fee_atoms"
  ],
  "additionalProperties": false
}
